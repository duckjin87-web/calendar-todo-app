rules_version = '2';

// 익명 로그인한 사용자만 읽기/쓰기 가능.
// (앱은 firebase.auth().signInAnonymously() 로 자동 로그인합니다)
// 전자책=읽기+완료체크 / 모바일=추가·수정·삭제 구분은 앱(클라이언트)에서 처리합니다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{doc} {
      allow read, write: if request.auth != null;
    }
    match /todos/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
